{
  "name": "coros-api",
  "version": "2.0.1",
  "description": "Coros API",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "format:check": "biome format src",
    "format:fix": "biome format --write src",
    "start": "nest start",
    "start:prod": "node dist/main",
    "lint:fix": "biome check --write --no-errors-on-unmatched .",
    "lint:check": "biome check --no-errors-on-unmatched .",
    "lint:ci": "biome ci --no-errors-on-unmatched",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xballoy/coros-api.git"
  },
  "author": "Xavier Balloy",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/xballoy/coros-api/issues"
  },
  "homepage": "https://github.com/xballoy/coros-api#readme",
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@nestjs/cli": "12.0.0",
    "@nestjs/schematics": "12.0.0",
    "@nestjs/testing": "12.0.1",
    "@swc-node/register": "1.12.1",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.16.2",
    "@tsconfig/node24": "24.0.5",
    "@types/node": "24.13.4",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "4.1.11",
    "fast-check": "4.10.0",
    "lefthook": "2.1.12",
    "msw": "2.15.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "unplugin-swc": "1.6.0",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@nestjs/axios": "12.0.0",
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "axios": "1.20.0",
    "dayjs": "1.11.23",
    "dotenv": "17.4.2",
    "nest-commander": "3.21.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.2"
  },
  "packageManager": "pnpm@12.4.1"
}
